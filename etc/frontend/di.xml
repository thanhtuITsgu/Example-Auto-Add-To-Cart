<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Intercept /checkout/ before Magento redirects an empty quote back to the cart -->
    <type name="Magento\Checkout\Controller\Index\Index">
        <plugin name="tuvo_auto_add_to_cart_checkout_link"
                type="TuVo\AutoAddToCart\Plugin\Checkout\IndexPlugin"
                sortOrder="10"/>
    </type>
</config>
