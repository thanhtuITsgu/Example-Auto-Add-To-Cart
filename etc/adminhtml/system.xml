<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="tuvo_auto_add_to_cart" translate="label" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Auto Add To Cart Links</label>
            <tab>sales</tab>
            <resource>Magento_Checkout::checkout</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="query_param" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Query Parameter</label>
                    <comment><![CDATA[Name of the URL parameter that holds the products, e.g. <code>/checkout/?products=SKU1:2,SKU2:1</code>]]></comment>
                    <validate>required-entry validate-code</validate>
                </field>
            </group>
        </section>
    </system>
</config>
